#!/usr/bin/env bash
#
# Decide whether this machine can sign commits, and record the answer.
#
# Git has no "sign if a key happens to be available" mode: commit.gpgsign is a
# plain boolean, and includeIf only conditions on gitdir/branch/remote URL --
# never on keyring state. Since .gitconfig is byte-identical on every machine
# and hardcodes a signing key, any box without that secret key (a fresh
# cloud-init host, say) fails *every* commit with `gpg: skipped ...: No secret
# key`.
#
# So the boolean gets computed here instead, and written to untracked local
# files that the tracked configs include last -- the same idiom config/ssh/config
# already uses with `Include ~/.ssh/config.d/*.conf`. Run from setup.sh at
# provision time and from .profile at every login, so importing a key and
# opening a new shell turns signing back on by itself.
#
# Covers git (~/.gitconfig.local) and jj (~/.config/jj/conf.d/), which duplicates
# the same key in config/jj/config.toml with signing.sign-all = true.

set -u

quiet=0
case "${1:-}" in
  --quiet | -q) quiet=1 ;;
  "") ;;
  *)
    echo "usage: git-signing-refresh [--quiet]" >&2
    exit 2
    ;;
esac

warn() {
  [ "$quiet" -eq 1 ] && return 0
  echo "git-signing-refresh: warning: $1" >&2
}

# Replace $1 with stdin, but only when the contents actually differ, so a login
# every few minutes doesn't churn the file's mtime. The temp file is a sibling
# so the rename is atomic.
write_if_changed() {
  local path="$1" tmp
  tmp=$(mktemp "$path.XXXXXX") || return 1
  cat >"$tmp"
  if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
    rm -f "$tmp"
  else
    chmod 644 "$tmp"
    mv -f "$tmp" "$path"
  fi
}

# Read the signing key from the *tracked* config, never from --global: --global
# would fold in the override this script generates, and the decision must not
# feed back into itself. `git config --file` leaves include directives
# unexpanded by default, which is exactly what's wanted here.
#
# Prefer the symlink in $HOME, but fall back to the repo copy for the case where
# setup.sh hasn't linked it yet.
here=$(cd "$(dirname "$0")" && pwd)
gitconfig=""
for candidate in "$HOME/.gitconfig" "$here/../.gitconfig"; do
  if [ -f "$candidate" ]; then
    gitconfig="$candidate"
    break
  fi
done

key=""
if [ -n "$gitconfig" ]; then
  key=$(git config --file "$gitconfig" --get user.signingkey 2>/dev/null) || key=""
fi

sign=true
if [ -z "$key" ]; then
  sign=false
  warn "no user.signingkey configured; commits on this machine will be unsigned"
elif ! command -v gpg >/dev/null 2>&1; then
  sign=false
  warn "gpg is not installed; commits on this machine will be unsigned"
elif ! gpg --list-secret-keys "$key" >/dev/null 2>&1; then
  # Presence in the keyring, not usability: a locked agent still signs fine
  # after a passphrase prompt, and probing that here would prompt at login.
  sign=false
  warn "gpg secret key $key not found; commits on this machine will be unsigned"
fi

write_if_changed "$HOME/.gitconfig.local" <<EOF
# Generated by bin/git-signing-refresh -- do not edit, changes are overwritten.
# Included last by .gitconfig, so these win over the defaults set there.
[commit]
	gpgsign = $sign
[tag]
	gpgsign = $sign
EOF

# jj reads conf.d/*.toml after config.toml, so this overrides signing.sign-all
# the same way. Only bother on machines where jj is actually set up.
jj_dir="${XDG_CONFIG_HOME:-$HOME/.config}/jj"
if [ -d "$jj_dir" ]; then
  mkdir -p "$jj_dir/conf.d" || exit 0
  write_if_changed "$jj_dir/conf.d/signing.toml" <<EOF
# Generated by bin/git-signing-refresh -- do not edit, changes are overwritten.
# Loaded after config.toml, so this wins over the sign-all set there.
[signing]
sign-all = $sign
EOF
fi
